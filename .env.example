# GEMINI_API_KEY: Required for Gemini AI API calls.
# Automatically provided by Google AI Studio / configure manually outside AI Studio.
GEMINI_API_KEY=""

# AI_FEATURES_ENABLED: Master runtime switch for Google Gemini product features ('true' | 'false').
# In Google AI Studio, GEMINI_API_KEY is injected as a managed secret.
# Set to 'false' (or leave unset) to disable all Gemini AI UI and endpoints with 503 while keeping core learning 100% functional.
# Set to 'true' to enable Gemini AI features (Conversation Lab, FlipLens, AI Practice, Explain My Mistake, Exam Analysis).
AI_FEATURES_ENABLED=false

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL=""

# Server Port (supplied automatically by hosting environment / Cloud Run)
PORT=5173

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development
